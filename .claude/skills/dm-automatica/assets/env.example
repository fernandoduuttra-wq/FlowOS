# Copie para .env.local (nunca comitado). Na Vercel, cadastre as mesmas
# variáveis em Settings > Environment Variables.

# --- Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / Instagram (App do INSTAGRAM, não o do Facebook)
IG_APP_ID=
IG_APP_SECRET=

# Você inventa este valor e repete no cadastro do webhook na Meta.
IG_WEBHOOK_VERIFY_TOKEN=

# --- Motor (você inventa; o mesmo valor vai no supabase/cron.sql)
CRON_SECRET=

# --- Senha do painel
PAINEL_SENHA=

# Endereço público do app. Em produção a Vercel preenche sozinha;
# preencha à mão se usar domínio próprio.
# APP_URL=https://seu-app.vercel.app
